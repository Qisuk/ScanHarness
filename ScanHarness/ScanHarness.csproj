<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ScanHarness.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- Guardrail controls, tools, agents and the egress policy; also copied next to the app (and to projects that reference it). -->
    <Content Update="controls.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="tools.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="agents.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="egress.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
