@page "/harness"
@using ScanHarness.Models
@using ScanHarness.Services
@inject ToolCallService ToolCallService
@inject LogService LogService
@inject IAgentBrain AgentBrain
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>Harness · ScanHarness</PageTitle>

<div class="harness-container">
    <header class="harness-header">
        <div>
            <h1 class="harness-title">Tool Harness</h1>
            <p class="harness-subtitle">Ask the agent to run simulated scanning and attack tools. Every call is logged.</p>
        </div>
        <span class="agent-chip" title="Agent brain in use">
            <span class="agent-chip-dot"></span> @AgentBrain.Name
        </span>
    </header>

    <div class="row g-4">
        <!-- Main Content Area -->
        <div class="col-lg-8">
            <!-- Tabs -->
            <ul class="nav harness-tabs mb-3">
                <li class="nav-item">
                    <a class="nav-link @(activeTab == "main" ? "active" : "")" 
                       style="cursor: pointer;" @onclick='() => activeTab = "main"'>
                        Main
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(activeTab == "history" ? "active" : "")" 
                       style="cursor: pointer;" @onclick='() => activeTab = "history"'>
                        History
                    </a>
                </li>
            </ul>

            <!-- Main Tab -->
            @if (activeTab == "main")
            {
                <div class="main-content">
                    <!-- Input Area (top) -->
                    <div class="input-area sh-card mb-3">
                        <h2 class="sh-section-title mb-1">Ask the agent</h2>
                        <p class="hint mb-3">
                            Describe what you want and the agent decides which tool to use.
                            Use <kbd>↑</kbd> <kbd>↓</kbd> to recall previous prompts.
                        </p>

                        <div class="input-group">
                            <input type="text" class="form-control"
                                   @bind="prompt" @bind:event="oninput"
                                   @onkeydown="HandlePromptKeyDown"
                                   placeholder="e.g. scan example.com for links, or attack example.com" />
                            <button class="btn btn-primary px-4" @onclick="SubmitPrompt"
                                    disabled="@(string.IsNullOrWhiteSpace(prompt) || isExecuting)">
                                @(isExecuting ? "Working..." : "Send")
                            </button>
                        </div>

                        @if (!string.IsNullOrEmpty(agentMessage))
                        {
                            <div class="agent-message mt-3">
                                <span class="agent-message-label">Agent</span>
                                <span>@agentMessage</span>
                            </div>
                        }
                    </div>

                    <!-- Tool Output Area -->
                    <div class="output-area sh-card">
                        <h2 class="sh-section-title mb-3">Tool Output</h2>
                        <div class="output-container">
                            @if (lastToolCall == null)
                            {
                                <div class="empty-state">No tool output yet. Ask the agent to run a tool to see results.</div>
                            }
                            else
                            {
                                <ToolOutputDisplay ToolCall="lastToolCall" />
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- History Tab -->
            @if (activeTab == "history")
            {
                <HistoryTab ToolCalls="ToolCallService.GetToolCalls()" />
            }
        </div>

        <!-- Activity Feed -->
        <div class="col-lg-4">
            <div class="activity-feed sh-card">
                <div class="feed-header d-flex justify-content-between align-items-center">
                    <h2 class="sh-section-title">Activity Feed</h2>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ClearLogs">Clear</button>
                </div>
                <div class="feed-items">
                    @if (!recentLogs.Any())
                    {
                        <div class="empty-state">Activity will appear here as you use the agent.</div>
                    }
                    @foreach (var log in recentLogs)
                    {
                        <ActivityFeedItem LogEntry="log" />
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Confirmation Modal -->
    @if (showConfirmation && pendingToolCall != null)
    {
        <ConfirmationModal ToolCall="pendingToolCall" 
                         OnApprove="ApproveToolCall" 
                         OnReject="RejectToolCall" />
    }
</div>

@code {
    private string activeTab = "main";
    private string prompt = "";
    private string agentMessage = "";
    private bool isExecuting = false;
    private ToolCall? lastToolCall;
    private ToolCall? pendingToolCall;
    private bool showConfirmation = false;
    private List<LogEntry> recentLogs = new();

    // Terminal-style prompt history. historyIndex == promptHistory.Count means "editing a new prompt".
    private readonly List<string> promptHistory = new();
    private int historyIndex = 0;

    protected override void OnInitialized()
    {
        ToolCallService.OnToolCallsChanged += OnToolCallsChanged;
        LogService.OnLogsChanged += OnLogsChanged;
    }

    private void OnToolCallsChanged()
    {
        recentLogs = LogService.GetRecentLogs(50);
        lastToolCall = ToolCallService.GetToolCalls().LastOrDefault();

        var waitingForApproval = ToolCallService.GetToolCalls()
            .FirstOrDefault(t => t.Status == ToolCallStatus.WaitingForApproval);

        if (waitingForApproval != null && waitingForApproval != pendingToolCall)
        {
            pendingToolCall = waitingForApproval;
            showConfirmation = true;
        }

        InvokeAsync(StateHasChanged);
    }

    private void OnLogsChanged()
    {
        recentLogs = LogService.GetRecentLogs(50);
        InvokeAsync(StateHasChanged);
    }

    // Terminal-style recall: Up walks to older prompts, Down walks back toward the new/empty prompt.
    private void HandlePromptKeyDown(KeyboardEventArgs e)
    {
        if (promptHistory.Count == 0)
            return;

        if (e.Key == "ArrowUp")
        {
            if (historyIndex > 0)
            {
                historyIndex--;
                prompt = promptHistory[historyIndex];
            }
        }
        else if (e.Key == "ArrowDown")
        {
            if (historyIndex < promptHistory.Count - 1)
            {
                historyIndex++;
                prompt = promptHistory[historyIndex];
            }
            else
            {
                // Past the newest entry: back to an empty, fresh prompt.
                historyIndex = promptHistory.Count;
                prompt = "";
            }
        }
    }

    private async Task SubmitPrompt()
    {
        if (string.IsNullOrWhiteSpace(prompt))
            return;

        isExecuting = true;
        var userPrompt = prompt.Trim();
        agentMessage = "";

        // Record in history (skip consecutive duplicates) and clear the input.
        if (promptHistory.LastOrDefault() != userPrompt)
        {
            promptHistory.Add(userPrompt);
        }
        historyIndex = promptHistory.Count;
        prompt = "";

        try
        {
            // Log the user's request, then let the agent decide which tool (if any) to call.
            LogService.LogUser($"Request: {userPrompt}");
            var decision = await AgentBrain.DecideAsync(userPrompt);
            agentMessage = decision.Message;

            if (!decision.ToolFound || decision.Tool == null || decision.Action == null)
            {
                // No suitable tool: report back to the user without calling anything.
                LogService.LogWarning($"No tool selected for request: {userPrompt}");
                return;
            }

            LogService.LogInfo($"Agent selected tool: {decision.Tool}/{decision.Action}");

            // The approval requirement comes from the agent's decision, not the user.
            // The confirmation modal only appears when the chosen tool requires approval.
            await ToolCallService.ExecuteToolAsync(
                decision.Tool,
                decision.Action,
                decision.Parameters,
                decision.RequiresApproval
            );
        }
        finally
        {
            isExecuting = false;
        }
    }

    private void ApproveToolCall()
    {
        if (pendingToolCall != null)
        {
            ToolCallService.ApproveToolCall(pendingToolCall.Id);
            showConfirmation = false;
            pendingToolCall = null;
        }
    }

    private void RejectToolCall()
    {
        if (pendingToolCall != null)
        {
            ToolCallService.RejectToolCall(pendingToolCall.Id);
            showConfirmation = false;
            pendingToolCall = null;
        }
    }

    private void ClearLogs()
    {
        LogService.Clear();
        recentLogs.Clear();
    }

    void IDisposable.Dispose()
    {
        ToolCallService.OnToolCallsChanged -= OnToolCallsChanged;
        LogService.OnLogsChanged -= OnLogsChanged;
    }
}

<style>
    .harness-container {
        max-width: 1400px;
    }

    .harness-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .harness-title {
        font-size: 1.5rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        margin: 0 0 0.25rem;
    }

    .harness-subtitle {
        color: var(--sh-text-muted);
        margin: 0;
    }

    .agent-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        white-space: nowrap;
        padding: 0.35rem 0.75rem;
        border: 1px solid var(--sh-border);
        border-radius: 999px;
        background: var(--sh-surface);
        font-size: 0.8rem;
        font-weight: 500;
        color: var(--sh-neutral);
    }

    .agent-chip-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--sh-success);
        box-shadow: 0 0 0 3px var(--sh-success-soft);
    }

    /* Underlined tabs rather than Bootstrap's boxed tabs. */
    .harness-tabs {
        gap: 1.5rem;
        border-bottom: 1px solid var(--sh-border);
    }

        .harness-tabs .nav-link {
            padding: 0.5rem 0;
            margin-bottom: -1px;
            color: var(--sh-text-muted);
            font-weight: 500;
            border-bottom: 2px solid transparent;
        }

            .harness-tabs .nav-link:hover {
                color: var(--sh-text);
            }

            .harness-tabs .nav-link.active {
                color: var(--sh-accent);
                border-bottom-color: var(--sh-accent);
            }

    .input-area,
    .output-area {
        padding: 1.25rem;
    }

    .hint {
        color: var(--sh-text-muted);
        font-size: 0.85rem;
    }

    .agent-message {
        display: flex;
        gap: 0.6rem;
        align-items: baseline;
        padding: 0.65rem 0.85rem;
        background: var(--sh-surface-muted);
        border: 1px solid var(--sh-border);
        border-radius: var(--sh-radius-sm);
        font-size: 0.9rem;
    }

    .agent-message-label {
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--sh-text-muted);
    }

    .output-area {
        min-height: 320px;
    }

    .empty-state {
        padding: 2rem 1rem;
        text-align: center;
        color: var(--sh-text-subtle);
        font-size: 0.875rem;
        border: 1px dashed var(--sh-border-strong);
        border-radius: var(--sh-radius-sm);
    }

    .activity-feed {
        height: calc(100vh - 220px);
        min-height: 420px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .feed-header {
        padding: 0.85rem 1.25rem;
        border-bottom: 1px solid var(--sh-border);
    }

    .feed-items {
        flex: 1;
        overflow-y: auto;
        padding: 0.75rem;
    }
</style>
