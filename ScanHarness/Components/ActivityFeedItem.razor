@using ScanHarness.Models

@* User actions sit flush left; the actions they trigger are indented so each
   request reads as a group of the calls it caused. *@
<div class="feed-item @StatusStyles.LevelClass(LogEntry.Level) @(IsUser ? "is-user" : "is-triggered")">
    <div class="feed-item-header">
        <span class="badge @StatusStyles.PillClass(LogEntry.Level)">@GetLabel()</span>
        <small class="feed-item-time" title="@LogEntry.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")">
            @LogEntry.Timestamp.ToLocalTime().ToString("HH:mm:ss")
        </small>
    </div>
    <div class="feed-item-message">@LogEntry.Message</div>
    @* Shown on the user's entries only; the entries they trigger are grouped underneath and share the brain. *@
    @if (IsUser && !string.IsNullOrEmpty(LogEntry.Brain))
    {
        <div class="feed-item-brain" title="Brain that handled this request">@LogEntry.Brain</div>
    }
</div>

@code {
    [Parameter]
    public LogEntry LogEntry { get; set; } = null!;

    private bool IsUser => LogEntry.Level == LogLevel.User;

    private string GetLabel() => IsUser ? "You" : LogEntry.Level.ToString();
}

<style>
    .feed-item {
        position: relative;
        padding: 0.35rem 0.55rem;
        margin-bottom: 0.35rem;
        border: 1px solid var(--sh-border);
        border-radius: var(--sh-radius-sm);
        background: var(--sh-surface);
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

        .feed-item:hover {
            border-color: var(--sh-border-strong);
            box-shadow: var(--sh-shadow);
        }

        .feed-item.is-user {
            margin-left: 0;
            margin-top: 0.55rem;
            background: var(--sh-surface-muted);
        }

        .feed-item.is-triggered {
            margin-left: 1.25rem;
        }

            /* A thin connector line ties triggered entries to the request above them. */
            .feed-item.is-triggered::before {
                content: "";
                position: absolute;
                left: -0.7rem;
                top: -0.35rem;
                bottom: 0;
                border-left: 1px solid var(--sh-border-strong);
            }

        /* Errors and warnings get a subtle accent so they still stand out. */
        .feed-item.level-error {
            border-left: 3px solid var(--sh-danger);
        }

        .feed-item.level-warning {
            border-left: 3px solid var(--sh-warning);
        }

    .feed-item-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.15rem;
    }

    .feed-item-time {
        color: var(--sh-text-subtle);
        font-family: var(--sh-font-mono);
        font-size: 0.72rem;
    }

    .feed-item-brain {
        display: inline-block;
        margin-top: 0.2rem;
        padding: 0.05rem 0.45rem;
        border: 1px solid var(--sh-border);
        border-radius: 999px;
        background: var(--sh-surface);
        color: var(--sh-text-muted);
        font-family: var(--sh-font-mono);
        font-size: 0.68rem;
    }

    .feed-item-message {
        font-size: 0.82rem;
        color: var(--sh-text);
        word-break: break-word;
    }
</style>
