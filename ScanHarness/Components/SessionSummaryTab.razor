@using ScanHarness.Models
@using ScanHarness.Services
@using ScanHarness.Services.Controls

@* The session report: the summary brain's summary of summaries, then the deterministic lists of
   controls tripped and tools called. *@
<div class="session-summary sh-box sh-box-success">
    <span class="sh-box-title">Session summary</span>
    @if (Report != null)
    {
        <span class="sh-box-aside">
            @Report.SummaryBrain · @Report.SummaryWordCount words · @Report.CreatedAt.ToLocalTime().ToString("HH:mm:ss")
        </span>
    }

    @if (IsGenerating)
    {
        <div class="empty-state">Summarising the session…</div>
    }
    else if (Report == null)
    {
        <div class="empty-state">Press <strong>Summarise session</strong> to summarise every action in this session.</div>
    }
    else
    {
        @* One pip per control tripped: up to 3 warnings and 3 blocks, each opening its details. *@
        var warnings = Report.Trips.Where(t => t.Violation.Mode == ControlMode.Advise).ToList();
        var blocks = Report.Trips.Where(t => t.Violation.Mode == ControlMode.Block).ToList();
        @if (Report.Trips.Count > 0)
        {
            <div class="session-pips" aria-label="@($"{Plural(warnings.Count, "warning")} and {Plural(blocks.Count, "block")} this session")">
                @foreach (var trip in warnings.Take(MaxPipsPerMode).Concat(blocks.Take(MaxPipsPerMode)))
                {
                    <ControlPip Violations="new[] { trip.Violation }" />
                }
                @{ var hidden = Math.Max(0, warnings.Count - MaxPipsPerMode) + Math.Max(0, blocks.Count - MaxPipsPerMode); }
                @if (hidden > 0)
                {
                    <span class="session-pips-more">+@hidden more</span>
                }
                <span class="session-pips-counts">@Plural(warnings.Count, "warning") · @Plural(blocks.Count, "block")</span>
            </div>
        }

        @foreach (var paragraph in Report.Summary.Split("\n\n", StringSplitOptions.RemoveEmptyEntries))
        {
            <p class="session-summary-text">@paragraph</p>
        }
        @if (Report.FallbackReason != null)
        {
            <p class="session-summary-note">The summary brain couldn't write this (@Report.FallbackReason), so the rule-based summary is shown.</p>
        }
    }
</div>

@if (Report != null && !IsGenerating)
{
    <div class="session-controls sh-box">
        <span class="sh-box-title">Controls tripped</span>
        <span class="sh-box-aside">@Report.Trips.Count in this session</span>
        @if (Report.Trips.Count == 0)
        {
            <div class="empty-state">No controls tripped in this session.</div>
        }
        else
        {
            <div class="session-tools-scroll">
                <table class="table session-tools-table session-controls-table mb-0">
                    <thead>
                        <tr>
                            <th class="col-number">#</th>
                            <th class="col-time">Time</th>
                            @if (ShowUsers)
                            {
                                <th class="col-user">User</th>
                            }
                            <th class="col-action">Action</th>
                            <th class="col-control">Control</th>
                            <th>Message that tripped it</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var trip in Report.Trips)
                        {
                            var isBlock = trip.Violation.Mode == ControlMode.Block;
                            <tr>
                                <td class="mono">@trip.Number</td>
                                <td class="mono">@trip.Time.ToLocalTime().ToString("HH:mm:ss")</td>
                                @if (ShowUsers)
                                {
                                    <td class="session-user">@(trip.UserName ?? "—")</td>
                                }
                                <td><span class="badge sh-pill @(isBlock ? "sh-pill-danger" : "sh-pill-warning")">@(isBlock ? "Block" : "Warning")</span></td>
                                <td>
                                    <div class="session-control-name">@trip.Violation.Name</div>
                                    <div class="session-control-stage">@trip.Violation.StageName · @trip.Violation.TargetDescription</div>
                                </td>
                                <td>
                                    <div class="session-control-message" title="@trip.Message">@trip.Message</div>
                                    <div class="session-control-stage">@trip.Violation.Detail</div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="session-shares sh-box">
        <span class="sh-box-title">Data shared externally</span>
        <span class="sh-box-aside">@Report.Shares.Count in this session</span>
        @if (Report.Shares.Count == 0)
        {
            <div class="empty-state">Nothing was offered to an external brain, tool or agent in this session.</div>
        }
        else
        {
            <div class="session-tools-scroll">
                <table class="table session-tools-table session-shares-table mb-0">
                    <thead>
                        <tr>
                            <th class="col-number">#</th>
                            <th class="col-time">Time</th>
                            @if (ShowUsers)
                            {
                                <th class="col-user">User</th>
                            }
                            <th>Data</th>
                            <th>To</th>
                            <th>Outcome</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var share in Report.Shares)
                        {
                            var handoff = share.Handoff;
                            var pill = handoff.Outcome switch
                            {
                                ScanHarness.Services.Boundaries.ShareOutcome.Blocked => "sh-pill-danger",
                                ScanHarness.Services.Boundaries.ShareOutcome.Pseudonymised => "sh-pill-warning",
                                _ => "sh-pill-info"
                            };
                            <tr>
                                <td class="mono">@share.Number</td>
                                <td class="mono">@share.Time.ToLocalTime().ToString("HH:mm:ss")</td>
                                @if (ShowUsers)
                                {
                                    <td class="session-user">@(share.UserName ?? "—")</td>
                                }
                                <td>@handoff.What <span class="session-control-stage">(@ScanHarness.Services.Boundaries.SensitivityExtensions.Label(handoff.Label))</span></td>
                                <td>@handoff.ToName <span class="session-control-stage">cleared for @ScanHarness.Services.Boundaries.SensitivityExtensions.Label(handoff.Clearance)</span></td>
                                <td>
                                    <span class="badge sh-pill @pill">@handoff.Outcome</span>
                                    @if (handoff.Placeholders > 0)
                                    {
                                        <span class="session-control-stage">@handoff.Placeholders placeholder@(handoff.Placeholders == 1 ? "" : "s")</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="session-tools sh-box">
        <span class="sh-box-title">Tools called</span>
        <span class="sh-box-aside">@Report.ToolCalls.Count in this session</span>
        <div class="session-tools-scroll">
            <table class="table session-tools-table mb-0">
                <thead>
                    <tr>
                        <th class="col-number">#</th>
                        <th class="col-time">Time</th>
                        @if (ShowUsers)
                        {
                            <th class="col-user">User</th>
                        }
                        <th class="col-tool">Tool</th>
                        <th>Parameters</th>
                        <th class="col-status">Status</th>
                        <th>Brain</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Report.ToolCalls)
                    {
                        <tr>
                            <td class="mono">@item.Number</td>
                            <td class="mono">@item.Time.ToLocalTime().ToString("HH:mm:ss")</td>
                            @if (ShowUsers)
                            {
                                <td class="session-user">@(item.UserName ?? "—")</td>
                            }
                            <td class="mono">@item.Tool/@item.Action</td>
                            <td class="mono">@(item.Parameters.Length == 0 ? "—" : item.Parameters)</td>
                            <td><span class="badge @StatusStyles.PillClass(item.Status)">@item.Status</span></td>
                            <td class="session-brain">@(item.Brain ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    /// <summary>The latest session report, or null before the first one is made.</summary>
    [Parameter]
    public SessionReport? Report { get; set; }

    /// <summary>True while the summary brain is writing the report.</summary>
    [Parameter]
    public bool IsGenerating { get; set; }

    /// <summary>Adds a User column (the admin view, which mixes users' calls).</summary>
    [Parameter]
    public bool ShowUsers { get; set; }

    // At most this many pips per mode (warnings, blocks) on the summary; the rest are counted.
    private const int MaxPipsPerMode = 3;

    private static string Plural(int n, string noun) => $"{n} {noun}{(n == 1 ? "" : "s")}";
}

<style>
    .session-summary {
        background: var(--sh-success-soft);
        font-size: 0.87rem;
        line-height: 1.5;
    }

        /* The title straddles the border: surface colour above it, the box's tint below. */
        .session-summary > .sh-box-title,
        .session-summary > .sh-box-aside {
            background: linear-gradient(var(--sh-surface) 55%, var(--sh-success-soft) 55%);
        }

    .session-summary-text {
        margin: 0 0 0.5rem;
    }

        .session-summary-text:last-of-type {
            margin-bottom: 0;
        }

    .session-summary-note {
        margin: 0.5rem 0 0;
        color: var(--sh-warning);
        font-size: 0.8rem;
    }

    .session-pips {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        margin: 0.1rem 0 0.5rem;
    }

    .session-pips-more,
    .session-pips-counts {
        font-size: 0.74rem;
        color: var(--sh-text-muted);
    }

    .session-pips-counts {
        margin-left: 0.3rem;
    }

    .session-controls {
        padding: 0.75rem 0.4rem 0.4rem;
    }

        .session-controls-table .col-action { width: 6.5rem; }
        .session-controls-table .col-control { width: 14rem; }

    .session-control-name {
        font-family: var(--sh-font-mono);
        font-weight: 600;
        font-size: 0.78rem;
    }

    .session-control-stage {
        color: var(--sh-text-muted);
        font-size: 0.72rem;
    }

    .session-control-message {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        white-space: pre-wrap;
    }

    .session-tools {
        padding: 0.75rem 0.4rem 0.4rem;
    }

    .session-tools-scroll {
        overflow: auto;
    }

    .session-tools-table {
        font-size: 0.82rem;
        min-width: 36rem;
        --bs-table-bg: transparent;
    }

        .session-tools-table thead th {
            background: var(--sh-surface-muted);
            color: var(--sh-text-muted);
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            border-bottom: 1px solid var(--sh-border);
            padding: 0.35rem 0.6rem;
        }

        .session-tools-table td {
            padding: 0.3rem 0.6rem;
            vertical-align: middle;
            border-color: var(--sh-border);
            overflow-wrap: anywhere;
        }

        .session-tools-table .col-number { width: 2.5rem; }
        .session-tools-table .col-time { width: 5rem; }
        .session-tools-table .col-tool { width: 11rem; }
        .session-tools-table .col-status { width: 8.5rem; }
        .session-tools-table .col-user { width: 5.5rem; }

    .session-user {
        color: var(--sh-user);
        font-weight: 600;
    }

        .session-tools-table .mono {
            font-family: var(--sh-font-mono);
            font-size: 0.78rem;
        }

    .session-brain {
        color: var(--sh-text-muted);
        font-family: var(--sh-font-mono);
        font-size: 0.76rem;
    }
</style>
