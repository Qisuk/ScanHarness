@using ScanHarness.Models

<div class="confirmation-modal-backdrop">
    <div class="confirmation-modal" role="dialog" aria-modal="true" aria-labelledby="confirm-title">
        <div class="confirm-header">
            <div class="confirm-icon" aria-hidden="true">!</div>
            <div>
                <h5 id="confirm-title" class="confirm-title">Authorization Required</h5>
                <p class="confirm-subtitle">This action requires your approval before it runs.</p>
            </div>
        </div>
        <div class="confirm-body">
            <dl class="confirm-details">
                <dt>Tool</dt>
                <dd>@ToolCall.Tool</dd>
                <dt>Action</dt>
                <dd>@ToolCall.Action</dd>
                @foreach (var param in ToolCall.Parameters)
                {
                    <dt>@param.Key</dt>
                    <dd>@param.Value</dd>
                }
            </dl>
        </div>
        <div class="confirm-footer">
            <button type="button" class="btn btn-outline-secondary" @onclick="OnReject">Reject</button>
            <button type="button" class="btn btn-danger" @onclick="OnApprove">Approve</button>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public ToolCall ToolCall { get; set; } = null!;

    [Parameter]
    public EventCallback OnApprove { get; set; }

    [Parameter]
    public EventCallback OnReject { get; set; }
}

<style>
    .confirmation-modal-backdrop {
        position: fixed;
        inset: 0;
        background-color: var(--sh-backdrop);
        backdrop-filter: blur(2px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        z-index: 1000;
    }

    .confirmation-modal {
        background: var(--sh-surface);
        border-radius: 12px;
        box-shadow: var(--sh-shadow-lg);
        width: 100%;
        max-width: 460px;
        animation: confirmIn 0.18s ease-out;
    }

    @@keyframes confirmIn {
        from {
            transform: translateY(8px) scale(0.98);
            opacity: 0;
        }
        to {
            transform: none;
            opacity: 1;
        }
    }

    .confirm-header {
        display: flex;
        gap: 0.9rem;
        align-items: flex-start;
        padding: 1.25rem 1.25rem 0.75rem;
    }

    .confirm-icon {
        flex: none;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        background: var(--sh-warning-soft);
        color: var(--sh-warning);
        font-weight: 700;
        box-shadow: 0 0 0 6px var(--sh-warning-soft);
    }

    .confirm-title {
        font-size: 1.05rem;
        font-weight: 600;
        margin: 0.1rem 0 0.2rem;
    }

    .confirm-subtitle {
        color: var(--sh-text-muted);
        font-size: 0.875rem;
        margin: 0;
    }

    .confirm-body {
        padding: 0.5rem 1.25rem 1rem;
        max-height: 400px;
        overflow-y: auto;
    }

    .confirm-details {
        display: grid;
        grid-template-columns: max-content 1fr;
        gap: 0.4rem 1rem;
        margin: 0;
        padding: 0.85rem 1rem;
        background: var(--sh-surface-muted);
        border: 1px solid var(--sh-border);
        border-radius: var(--sh-radius-sm);
        font-size: 0.85rem;
    }

        .confirm-details dt {
            font-weight: 500;
            color: var(--sh-text-muted);
        }

        .confirm-details dd {
            margin: 0;
            font-family: var(--sh-font-mono);
            word-break: break-all;
        }

    .confirm-footer {
        display: flex;
        gap: 0.5rem;
        justify-content: flex-end;
        padding: 0.85rem 1.25rem;
        border-top: 1px solid var(--sh-border);
        background: var(--sh-surface-muted);
        border-radius: 0 0 12px 12px;
    }
</style>
