@using ScanHarness.Models
@using ScanHarness.Services

@* Each part of the call sits in its own titled box; parameters and result share a row to save height. *@
<div class="output-display">
    <div class="output-header">
        <div class="output-tool">
            <span class="output-tool-name">@ToolCall.Tool</span>
            <span class="output-tool-sep">/</span>
            <span>@ToolCall.Action</span>
        </div>
        <small class="output-time">@ToolCall.CreatedAt.ToLocalTime().ToString("HH:mm:ss")</small>
        <span class="badge @StatusStyles.PillClass(ToolCall.Status)">@ToolCall.Status</span>
    </div>

    @if (!string.IsNullOrEmpty(ToolCall.Summary))
    {
        <div class="sh-box sh-box-success output-summary">
            <span class="sh-box-title">Summary</span>
            @ToolCall.Summary
        </div>
    }

    @if (Reasoning is { Count: > 0 })
    {
        <div class="sh-box output-reasoning">
            <span class="sh-box-title">Reasoning</span>
            <span class="sh-box-aside">@Reasoning.Count @(Reasoning.Count == 1 ? "step" : "steps")</span>
            <ReasoningSteps Steps="Reasoning" Controls="ReasoningControls" />
        </div>
    }

    @if (ToolCall.Status == ToolCallStatus.Failed)
    {
        <div class="output-alert">Tool execution failed@(string.IsNullOrEmpty(ToolCall.Error) ? "." : $": {ToolCall.Error}")</div>
    }

    <div class="output-row">
        @if (ToolCall.Parameters.Any() || ToolCall.Brain != null)
        {
            <div class="sh-box output-params-box">
                <span class="sh-box-title">Parameters</span>
                <dl class="output-params">
                    @if (ToolCall.Brain != null)
                    {
                        <dt>brain</dt>
                        <dd>@ToolCall.Brain</dd>
                    }
                    @if (ToolCall.SummaryBrain != null && ToolCall.SummaryBrain != ToolCall.Brain)
                    {
                        <dt>summary brain</dt>
                        <dd>@ToolCall.SummaryBrain</dd>
                    }
                    @foreach (var param in ToolCall.Parameters)
                    {
                        <dt>@param.Key</dt>
                        <dd>@param.Value</dd>
                    }
                </dl>
            </div>
        }

        @if (!string.IsNullOrEmpty(ToolCall.Result))
        {
            <div class="sh-box output-result-box">
                <span class="sh-box-title">Result</span>
                <pre class="result-json sh-code">@FormatResult()</pre>
            </div>
        }
    </div>

    @if (Network is { Count: > 0 })
    {
        var refused = Network.Count(n => !n.Allowed);
        <div class="sh-box output-network" data-testid="network-connections">
            <span class="sh-box-title">Network</span>
            <span class="sh-box-aside">@Network.Count @(Network.Count == 1 ? "connection" : "connections")@(refused > 0 ? $" · {refused} refused" : "")</span>
            <ul class="network-list">
                @foreach (var connection in Network)
                {
                    <li class="network-item @(connection.Allowed ? "network-allowed" : "network-refused")">
                        <span class="network-outcome">@(connection.Allowed ? "Allowed" : "Refused")</span>
                        <span class="network-target">@connection.Describe()</span>
                        @if (Traffic(connection) is string traffic)
                        {
                            <span class="network-traffic">@traffic</span>
                        }
                        <span class="network-reason">@connection.Reason</span>
                    </li>
                }
            </ul>
        </div>
    }
</div>

@code {
    [Parameter]
    public ToolCall ToolCall { get; set; } = null!;

    /// <summary>The models' reasoning behind this call's request: the decision, any agent, and the summary.</summary>
    [Parameter]
    public IReadOnlyList<ReasoningStep>? Reasoning { get; set; }

    [Parameter]
    public IReadOnlyList<ScanHarness.Services.Controls.ControlViolation> ReasoningControls { get; set; } = Array.Empty<ScanHarness.Services.Controls.ControlViolation>();

    /// <summary>Connections the tool made through the egress proxy, oldest first (none when egress control is off).</summary>
    [Parameter]
    public IReadOnlyList<EgressEvent>? Network { get; set; }

    // Pretty-print the result when it is valid JSON; otherwise show it as-is.
    private string FormatResult() => JsonFormatter.Pretty(ToolCall.Result);

    // e.g. "536 B sent · 5.6 KB received · 1.0 s", once the proxy's access log has reported the connection.
    internal static string? Traffic(EgressEvent connection)
    {
        if (connection.BytesSent == null && connection.BytesReceived == null)
            return null;
        var parts = new List<string> { $"{Size(connection.BytesSent ?? 0)} sent", $"{Size(connection.BytesReceived ?? 0)} received" };
        if (connection.DurationMs is long ms)
            parts.Add($"{ms / 1000.0:0.0} s");
        return string.Join(" · ", parts);
    }

    internal static string Size(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:0.0} KB",
        _ => $"{bytes / (1024.0 * 1024):0.0} MB",
    };
}

<style>
    .output-display {
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
    }

    .output-header {
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }

    .output-tool {
        font-family: var(--sh-font-mono);
        font-size: 0.85rem;
        margin-right: auto;
    }

    .output-tool-name {
        font-weight: 600;
    }

    .output-tool-sep {
        color: var(--sh-text-subtle);
        margin: 0 0.15rem;
    }

    .output-time {
        color: var(--sh-text-subtle);
        font-family: var(--sh-font-mono);
        font-size: 0.72rem;
    }

    .output-summary {
        background: var(--sh-success-soft);
        font-size: 0.85rem;
        line-height: 1.45;
    }

    .output-reasoning {
        background: var(--sh-info-soft);
    }

        /* The title straddles the border: white above it, the box's tint below. */
        .output-summary > .sh-box-title {
            background: linear-gradient(var(--sh-surface) 55%, var(--sh-success-soft) 55%);
        }

    .output-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.9rem 0.6rem;
        align-items: flex-start;
    }

    /* Sized to its content (up to a limit) so short values don't wrap mid-word. */
    .output-params-box {
        flex: 0 1 auto;
        max-width: 26rem;
    }

    .output-result-box {
        flex: 1 1 20rem;
        padding: 0.8rem 0.4rem 0.4rem;
    }

    .output-params {
        display: grid;
        grid-template-columns: max-content 1fr;
        gap: 0.2rem 0.75rem;
        margin: 0;
        font-size: 0.8rem;
    }

        .output-params dt {
            font-weight: 500;
            color: var(--sh-text-muted);
        }

        .output-params dd {
            margin: 0;
            font-family: var(--sh-font-mono);
            overflow-wrap: anywhere;
        }

    .output-alert {
        padding: 0.4rem 0.6rem;
        border: 1px solid var(--sh-danger-border);
        border-radius: var(--sh-radius-sm);
        background: var(--sh-danger-soft);
        color: var(--sh-danger);
        font-size: 0.82rem;
        font-weight: 500;
    }

    .result-json {
        max-height: 320px;
        border: none;
        padding: 0.3rem;
    }

    .network-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        font-size: 0.8rem;
    }

    .network-item {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.2rem 0.6rem;
        padding: 0.3rem 0.5rem;
        border-left: 3px solid var(--sh-success-border);
        border-radius: var(--sh-radius-sm);
    }

        .network-item.network-refused {
            border-left-color: var(--sh-danger-border);
            background: var(--sh-danger-soft);
        }

    .network-outcome {
        font-weight: 600;
        min-width: 4.5rem;
    }

    .network-refused .network-outcome {
        color: var(--sh-danger);
    }

    .network-target {
        font-family: var(--sh-font-mono);
        overflow-wrap: anywhere;
    }

    .network-traffic {
        color: var(--sh-text-subtle);
        font-family: var(--sh-font-mono);
        font-size: 0.72rem;
    }

    .network-reason {
        flex-basis: 100%;
        color: var(--sh-text-muted);
    }
</style>
