@using ScanHarness.Models
@using ScanHarness.Services

<div class="output-display">
    <div class="output-header">
        <span class="badge me-2" style="@GetStatusBadgeStyle()">@ToolCall.Status</span>
        <small class="text-muted">@ToolCall.CreatedAt.ToLocalTime().ToString("HH:mm:ss")</small>
    </div>

    <div class="output-body">
        <p><strong>Tool:</strong> @ToolCall.Tool / @ToolCall.Action</p>

        @if (ToolCall.Parameters.Any())
        {
            <p><strong>Parameters:</strong></p>
            <ul class="small">
                @foreach (var param in ToolCall.Parameters)
                {
                    <li>@param.Key: @param.Value</li>
                }
            </ul>
        }

        @if (!string.IsNullOrEmpty(ToolCall.Result))
        {
            <p><strong>Result:</strong></p>
            <pre class="result-json">@FormatResult()</pre>
        }

        @if (ToolCall.Status == ToolCallStatus.Failed)
        {
            <div class="alert alert-danger">Tool execution failed</div>
        }
    </div>
</div>

@code {
    [Parameter]
    public ToolCall ToolCall { get; set; } = null!;

    // Pretty-print the result when it is valid JSON; otherwise show it as-is.
    private string FormatResult() => JsonFormatter.Pretty(ToolCall.Result);

    private string GetStatusBadgeStyle()
    {
        return ToolCall.Status switch
        {
            ToolCallStatus.Completed => "background-color: #198754;",
            ToolCallStatus.Failed => "background-color: #dc3545;",
            ToolCallStatus.WaitingForApproval => "background-color: #ffc107; color: #000;",
            ToolCallStatus.Running => "background-color: #0dcaf0;",
            _ => "background-color: #6c757d;"
        };
    }
}

<style>
    .output-display {
        border: 1px solid #dee2e6;
        border-radius: 4px;
        padding: 10px;
    }

    .output-header {
        margin-bottom: 10px;
        padding-bottom: 10px;
        border-bottom: 1px solid #dee2e6;
    }

    .result-json {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 3px;
        padding: 10px;
        max-height: 260px;
        overflow: auto;
        white-space: pre;
        font-family: Consolas, "Courier New", monospace;
        font-size: 12px;
        line-height: 1.4;
        margin-bottom: 0;
    }
</style>
