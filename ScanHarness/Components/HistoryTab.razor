@using ScanHarness.Models

<div class="history-view">
    <table class="table table-sm table-hover">
        <thead class="table-light">
            <tr>
                <th>Time</th>
                <th>Tool</th>
                <th>Action</th>
                <th>Status</th>
                <th>Result</th>
            </tr>
        </thead>
        <tbody>
            @if (!ToolCalls.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted">No tool calls yet</td>
                </tr>
            }
            else
            {
                @foreach (var call in ToolCalls.OrderByDescending(t => t.CreatedAt))
                {
                    <tr style="cursor: pointer;" @onclick="() => expandedId = expandedId == call.Id ? null : call.Id">
                        <td>@call.CreatedAt:HH:mm:ss</td>
                        <td>@call.Tool</td>
                        <td>@call.Action</td>
                        <td>
                            <span class="badge" style="@GetStatusBadgeStyle(call.Status)">
                                @call.Status
                            </span>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(call.Result))
                            {
                                <span class="text-success">✓</span>
                            }
                        </td>
                    </tr>
                    @if (expandedId == call.Id)
                    {
                        <tr>
                            <td colspan="5">
                                <div class="expanded-details">
                                    <strong>Parameters:</strong>
                                    <pre>@string.Join("\n", call.Parameters.Select(p => $"{p.Key}: {p.Value}"))</pre>

                                    @if (!string.IsNullOrEmpty(call.Result))
                                    {
                                        <strong>Result:</strong>
                                        <pre>@call.Result</pre>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter]
    public List<ToolCall> ToolCalls { get; set; } = new();

    private string? expandedId;

    private string GetStatusBadgeStyle(ToolCallStatus status)
    {
        return status switch
        {
            ToolCallStatus.Completed => "background-color: #198754;",
            ToolCallStatus.Failed => "background-color: #dc3545;",
            ToolCallStatus.WaitingForApproval => "background-color: #ffc107; color: #000;",
            ToolCallStatus.Running => "background-color: #0dcaf0;",
            _ => "background-color: #6c757d;"
        };
    }
}

<style>
    .history-view {
        height: 100%;
        overflow-y: auto;
    }

    .expanded-details {
        background-color: #f8f9fa;
        padding: 10px;
        border-radius: 4px;
        margin: 10px 0;
    }

    .expanded-details pre {
        background-color: #fff;
        border: 1px solid #dee2e6;
        padding: 8px;
        border-radius: 3px;
        max-height: 200px;
        overflow-y: auto;
        font-size: 11px;
    }
</style>
