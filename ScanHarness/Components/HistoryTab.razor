@using ScanHarness.Models

<div class="history-view sh-box">
    <span class="sh-box-title">Tool call history</span>
    <span class="sh-box-aside">@ToolCalls.Count calls · click a row for details</span>
    <div class="history-scroll">
        <table class="table history-table mb-0">
            <thead>
                <tr>
                    <th class="col-time">Time</th>
                    @if (ShowUsers)
                    {
                        <th class="col-user">User</th>
                    }
                    <th class="col-tool">Tool</th>
                    <th class="col-action">Action</th>
                    <th>Brain</th>
                    <th class="col-status">Status</th>
                    <th class="col-result text-end">Result</th>
                </tr>
            </thead>
            <tbody>
                @if (!ToolCalls.Any())
                {
                    <tr>
                        <td colspan="@ColumnCount" class="history-empty">No tool calls yet</td>
                    </tr>
                }
                else
                {
                    @foreach (var call in ToolCalls.OrderByDescending(t => t.CreatedAt))
                    {
                        <tr class="history-row @(expandedId == call.Id ? "is-expanded" : "")"
                            @onclick="() => expandedId = expandedId == call.Id ? null : call.Id">
                            <td class="mono">@call.CreatedAt.ToLocalTime().ToString("HH:mm:ss")</td>
                            @if (ShowUsers)
                            {
                                <td class="history-user">@(call.UserName ?? "—")</td>
                            }
                            <td>@call.Tool</td>
                            <td>@call.Action</td>
                            <td class="history-brain">@(call.Brain ?? "—")</td>
                            <td>
                                <span class="badge @StatusStyles.PillClass(call.Status)">@call.Status</span>
                            </td>
                            <td class="text-end">
                                @if (!string.IsNullOrEmpty(call.Result))
                                {
                                    <span class="history-has-result" title="Has result">✓</span>
                                }
                            </td>
                        </tr>
                        @if (expandedId == call.Id)
                        {
                            <tr class="history-details-row">
                                <td colspan="@ColumnCount">
                                    <div class="expanded-details">
                                        @if (!string.IsNullOrEmpty(call.Summary))
                                        {
                                            <div class="output-label">Summary</div>
                                            <p class="history-summary">@call.Summary</p>
                                        }
                                        <dl class="history-facts">
                                            <dt>Requested</dt>
                                            <dd>@call.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")@(call.UserName != null ? $" by {call.UserName}" : "")</dd>
                                            @if (call.ApprovalDecision != null)
                                            {
                                                <dt>Approval</dt>
                                                <dd>@call.ApprovalDecision@(call.ApprovalDecidedBy != null ? $" by {call.ApprovalDecidedBy}" : "")@(call.ApprovalDecidedAt is DateTime decided ? $" at {decided.ToLocalTime():HH:mm:ss}" : "")</dd>
                                            }
                                            @if (call.CompletedAt is DateTime completed)
                                            {
                                                <dt>Finished</dt>
                                                <dd>@completed.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</dd>
                                            }
                                            @if (!string.IsNullOrEmpty(call.Error))
                                            {
                                                <dt>Error</dt>
                                                <dd>@call.Error</dd>
                                            }
                                        </dl>
                                        <div class="output-label">Parameters</div>
                                        <pre class="sh-code">@(call.Parameters.Count == 0 ? "(none)" : string.Join("\n", call.Parameters.Select(p => $"{p.Key}: {p.Value}")))</pre>
    
                                        @if (!string.IsNullOrEmpty(call.Result))
                                        {
                                            <div class="output-label mt-3">Result</div>
                                            <pre class="sh-code">@ScanHarness.Services.JsonFormatter.Pretty(call.Result)</pre>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    [Parameter]
    public List<ToolCall> ToolCalls { get; set; } = new();

    /// <summary>Adds a User column (the admin view, which mixes users' calls).</summary>
    [Parameter]
    public bool ShowUsers { get; set; }

    private int ColumnCount => ShowUsers ? 7 : 6;

    private string? expandedId;
}

<style>
    .history-view {
        padding: 0.75rem 0.4rem 0.4rem;
    }

    /* Scroll inside the box so the title set into its border is never clipped. */
    .history-scroll {
        overflow: auto;
    }

    /* Fixed layout keeps long expanded content (JSON, summaries) inside the box instead of widening the table. */
    /* The minimum width guarantees the Brain column room; narrower panels scroll sideways instead. */
    .history-table {
        table-layout: fixed;
        width: 100%;
        min-width: 38rem;
        font-size: 0.85rem;
        --bs-table-bg: transparent;
    }

        .history-table .col-time { width: 4.75rem; }
        .history-table .col-tool { width: 5.5rem; }
        .history-table .col-action { width: 7.25rem; }
        .history-table .col-status { width: 8.25rem; }
        .history-table .col-result { width: 3.75rem; }

        .history-table thead th {
            background: var(--sh-surface-muted);
            color: var(--sh-text-muted);
            font-size: 0.72rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            border-bottom: 1px solid var(--sh-border);
            padding: 0.35rem 0.6rem;
        }

        .history-table td {
            padding: 0.35rem 0.6rem;
            vertical-align: middle;
            border-color: var(--sh-border);
            overflow-wrap: anywhere;
        }

    .history-row {
        cursor: pointer;
    }

        .history-row:hover td,
        .history-row.is-expanded td {
            background: var(--sh-surface-muted);
        }

    .history-table .mono {
        font-family: var(--sh-font-mono);
        font-size: 0.8rem;
        color: var(--sh-text-muted);
    }

    .history-brain {
        font-family: var(--sh-font-mono);
        font-size: 0.78rem;
        color: var(--sh-text-muted);
    }

    .history-table .col-user { width: 5.5rem; }

    .history-user {
        color: var(--sh-user);
        font-weight: 600;
        font-size: 0.8rem;
    }

    .history-facts {
        display: grid;
        grid-template-columns: max-content 1fr;
        gap: 0.15rem 0.75rem;
        margin: 0 0 0.6rem;
        font-size: 0.8rem;
    }

        .history-facts dt {
            font-weight: 500;
            color: var(--sh-text-muted);
        }

        .history-facts dd {
            margin: 0;
        }

    .history-summary {
        margin: 0 0 0.75rem;
        font-size: 0.85rem;
        line-height: 1.5;
    }

    .history-has-result {
        color: var(--sh-success);
        font-weight: 600;
    }

    .history-empty {
        text-align: center;
        color: var(--sh-text-subtle);
        padding: 1rem !important;
    }

    .history-details-row td {
        background: var(--sh-surface-muted);
    }

    .expanded-details {
        padding: 0.25rem 0 0.5rem;
    }

        .expanded-details .output-label {
            font-size: 0.72rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--sh-text-muted);
            margin-bottom: 0.35rem;
        }

        .expanded-details .sh-code {
            background: var(--sh-surface);
            max-height: 220px;
        }
</style>
