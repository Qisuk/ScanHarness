{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Controls": {
    "DefinitionsPath": "controls.json"
  },
  "Persistence": {
    "DatabasePath": "Data/scanharness.db"
  },
  "Llm": {
    "Enabled": true,
    "BaseUrl": "http://localhost:11434/v1",
    "ApiKey": "",
    "DefaultModel": "",
    "DefaultSummaryModel": "",
    "DecisionMode": "JsonSchema",
    "Temperature": 0,
    "TimeoutSeconds": 180,
    "ExcludeModelPatterns": [ "embed" ],
    "Classification": "",
    "ModelClassifications": {}
  },
  "Tools": {
    "BaseUrl": "https://localhost:7031",
    "DefinitionsPath": "tools.json",
    "Classifications": {
      "simple_scanner": "Internal",
      "attack": "External",
      "weather_forecast": "External"
    }
  },
  "Agents": {
    "DefinitionsPath": "agents.json",
    "MaxDepth": 2,
    "TimeoutSeconds": 120,
    "DayRate": 1200,
    "Currency": "GBP"
  },
  "Engagements": {
    "EnforceScope": true,
    "VerifiedDomains": [ "example.com", "example.org", "acme.test" ]
  }
}
