<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Web SDK so the ScanHarness web project (and its ASP.NET Core dependencies) can be referenced. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScanHarness\ScanHarness.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="eval-cases.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
