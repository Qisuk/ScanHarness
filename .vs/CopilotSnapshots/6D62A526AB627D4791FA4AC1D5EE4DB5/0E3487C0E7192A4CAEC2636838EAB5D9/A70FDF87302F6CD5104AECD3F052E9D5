using Microsoft.AspNetCore.Mvc;
using DemoToolAPI_1.Models;
using System.ComponentModel.DataAnnotations;

namespace DemoToolAPI_1.Controllers
{
    /// <summary>
    /// Controller for demo tool APIs
    /// </summary>
    [ApiController]
    [Route("api/[controller]")]
    public class ToolsController : ControllerBase
    {
        private static readonly Random _random = new();

        /// <summary>
        /// Scans a given URL and returns a list of all links found on the site
        /// </summary>
        /// <param name="url">The URL to scan</param>
        /// <returns>ScannerResponse with links found or error message</returns>
        [HttpGet("simple-scanner")]
        public IActionResult SimpleScanner([FromQuery] string url)
        {
            if (string.IsNullOrWhiteSpace(url))
            {
                return BadRequest(new ScannerResponse
                {
                    Status = "error",
                    Message = "URL parameter is required"
                });
            }

            var dummyResponses = new List<ScannerResponse>
            {
                // Success responses
                new ScannerResponse
                {
                    Status = "success",
                    Message = "Scan completed successfully. Found 5 links.",
                    Links = new List<LinkInfo>
                    {
                        new() { LinkText = "Home", Url = "https://example.com/" },
                        new() { LinkText = "About", Url = "https://example.com/about" },
                        new() { LinkText = "Contact", Url = "https://example.com/contact" },
                        new() { LinkText = "Products", Url = "https://example.com/products" },
                        new() { LinkText = "Blog", Url = "https://example.com/blog" }
                    }
                },
                new ScannerResponse
                {
                    Status = "success",
                    Message = "Scan completed successfully. Found 3 links.",
                    Links = new List<LinkInfo>
                    {
                        new() { LinkText = "Login", Url = "https://example.com/login" },
                        new() { LinkText = "Sign Up", Url = "https://example.com/signup" },
                        new() { LinkText = "Privacy Policy", Url = "https://example.com/privacy" }
                    }
                },
                new ScannerResponse
                {
                    Status = "success",
                    Message = "Scan completed successfully. Found 8 links.",
                    Links = new List<LinkInfo>
                    {
                        new() { LinkText = "Home", Url = "https://example.com/" },
                        new() { LinkText = "Services", Url = "https://example.com/services" },
                        new() { LinkText = "Portfolio", Url = "https://example.com/portfolio" },
                        new() { LinkText = "Team", Url = "https://example.com/team" },
                        new() { LinkText = "Blog", Url = "https://example.com/blog" },
                        new() { LinkText = "Contact", Url = "https://example.com/contact" },
                        new() { LinkText = "FAQ", Url = "https://example.com/faq" },
                        new() { LinkText = "Support", Url = "https://example.com/support" }
                    }
                },
                new ScannerResponse
                {
                    Status = "success",
                    Message = "Scan completed successfully. Found 2 links.",
                    Links = new List<LinkInfo>
                    {
                        new() { LinkText = "Main", Url = "https://example.com/" },
                        new() { LinkText = "Download", Url = "https://example.com/download" }
                    }
                },
                // Partial/Warning responses
                new ScannerResponse
                {
                    Status = "partial",
                    Message = "Scan completed with warnings. Some links could not be accessed. Found 4 links.",
                    Links = new List<LinkInfo>
                    {
                        new() { LinkText = "Home", Url = "https://example.com/" },
                        new() { LinkText = "About", Url = "https://example.com/about" },
                        new() { LinkText = "Gallery", Url = "https://example.com/gallery" },
                        new() { LinkText = "Contact", Url = "https://example.com/contact" }
                    }
                },
                new ScannerResponse
                {
                    Status = "partial",
                    Message = "Scan timed out after 30 seconds. Partial results returned.",
                    Links = new List<LinkInfo>
                    {
                        new() { LinkText = "Home", Url = "https://example.com/" },
                        new() { LinkText = "Products", Url = "https://example.com/products" }
                    }
                },
                // Failure responses
                new ScannerResponse
                {
                    Status = "failure",
                    Message = "Failed to connect to the specified URL. The host may be unreachable.",
                    Links = new List<LinkInfo>()
                },
                new ScannerResponse
                {
                    Status = "failure",
                    Message = "Access denied. The server refused the connection.",
                    Links = new List<LinkInfo>()
                },
                // Error responses
                new ScannerResponse
                {
                    Status = "error",
                    Message = "An unexpected error occurred during scanning. Please try again later.",
                    Links = new List<LinkInfo>()
                },
                new ScannerResponse
                {
                    Status = "error",
                    Message = "Invalid URL format. Please provide a valid URL.",
                    Links = new List<LinkInfo>()
                }
            };

            var randomResponse = dummyResponses[_random.Next(dummyResponses.Count)];
            return Ok(randomResponse);
        }

        /// <summary>
        /// Performs a simulated attack on a given URL
        /// </summary>
        /// <param name="url">The URL to attack</param>
        /// <returns>AttackResponse with attack simulation results</returns>
        [HttpPost("attack")]
        public IActionResult Attack([FromQuery] string url)
        {
            if (string.IsNullOrWhiteSpace(url))
            {
                return BadRequest(new AttackResponse
                {
                    Status = "error",
                    Message = "URL parameter is required"
                });
            }

            var dummyResponses = new List<AttackResponse>
            {
                // Success - No vulnerabilities found
                new AttackResponse
                {
                    Status = "success",
                    Message = "Attack simulation completed. No vulnerabilities found.",
                    Severity = "none",
                    VulnerabilitiesFound = 0,
                    Details = new Dictionary<string, object>
                    {
                        { "duration_ms", 2500 },
                        { "tests_run", 150 }
                    }
                },
                // Success - Low severity findings
                new AttackResponse
                {
                    Status = "success",
                    Message = "Attack simulation completed. Low severity vulnerabilities detected.",
                    Severity = "low",
                    VulnerabilitiesFound = 3,
                    Details = new Dictionary<string, object>
                    {
                        { "duration_ms", 3100 },
                        { "tests_run", 150 },
                        { "findings", new[] { "Missing security headers", "Outdated library detected", "Weak password policy" } }
                    }
                },
                // Success - Medium severity findings
                new AttackResponse
                {
                    Status = "success",
                    Message = "Attack simulation completed. Medium severity vulnerabilities detected.",
                    Severity = "medium",
                    VulnerabilitiesFound = 5,
                    Details = new Dictionary<string, object>
                    {
                        { "duration_ms", 3500 },
                        { "tests_run", 150 },
                        { "findings", new[] { "SQL injection risk", "Cross-site scripting vulnerability", "Insecure cookies", "Missing rate limiting", "Verbose error messages" } }
                    }
                },
                // Success - High severity findings
                new AttackResponse
                {
                    Status = "success",
                    Message = "Attack simulation completed. High severity vulnerabilities detected!",
                    Severity = "high",
                    VulnerabilitiesFound = 8,
                    Details = new Dictionary<string, object>
                    {
                        { "duration_ms", 4200 },
                        { "tests_run", 150 },
                        { "findings", new[] { "Remote code execution risk", "Authentication bypass", "Privilege escalation", "Unencrypted data transmission", "Insecure deserialization", "Directory traversal", "Command injection", "Broken access control" } }
                    }
                },
                // Partial success
                new AttackResponse
                {
                    Status = "partial",
                    Message = "Attack simulation partially completed. Some tests could not be executed.",
                    Severity = "medium",
                    VulnerabilitiesFound = 2,
                    Details = new Dictionary<string, object>
                    {
                        { "duration_ms", 2800 },
                        { "tests_run", 98 },
                        { "findings", new[] { "Missing HTTPS", "Insecure session handling" } },
                        { "skipped_tests", 52 }
                    }
                },
                // Failure - Cannot connect
                new AttackResponse
                {
                    Status = "failure",
                    Message = "Failed to initiate attack simulation. Cannot connect to the target URL.",
                    Severity = "unknown",
                    VulnerabilitiesFound = 0,
                    Details = new Dictionary<string, object>
                    {
                        { "duration_ms", 500 },
                        { "tests_run", 0 }
                    }
                },
                // Failure - Blocked by WAF
                new AttackResponse
                {
                    Status = "failure",
                    Message = "Attack simulation blocked. The target appears to have Web Application Firewall protection enabled.",
                    Severity = "unknown",
                    VulnerabilitiesFound = 0,
                    Details = new Dictionary<string, object>
                    {
                        { "duration_ms", 1200 },
                        { "tests_run", 25 },
                        { "blocked_by", "WAF" }
                    }
                },
                // Error - Timeout
                new AttackResponse
                {
                    Status = "error",
                    Message = "Attack simulation timed out after 30 seconds. The target responded too slowly.",
                    Severity = "unknown",
                    VulnerabilitiesFound = 0,
                    Details = new Dictionary<string, object>
                    {
                        { "duration_ms", 30000 },
                        { "tests_run", 45 }
                    }
                },
                // Error - Invalid URL
                new AttackResponse
                {
                    Status = "error",
                    Message = "Invalid URL format. Please provide a valid URL.",
                    Severity = "unknown",
                    VulnerabilitiesFound = 0,
                    Details = new Dictionary<string, object>()
                },
                // Error - Unexpected
                new AttackResponse
                {
                    Status = "error",
                    Message = "An unexpected error occurred during attack simulation. Please try again later.",
                    Severity = "unknown",
                    VulnerabilitiesFound = 0,
                    Details = new Dictionary<string, object>
                    {
                        { "error_code", "INTERNAL_ERROR" }
                    }
                }
            };

            var randomResponse = dummyResponses[_random.Next(dummyResponses.Count)];
            return Ok(randomResponse);
        }
    }
}
